          "id": "dfafda6e-42c9-4fe9-95b3-29bf134b4078",
          "name": "Get job details",
          "request": {
            "name": "Get job details",
            "description": {
              "content": "Returns job status. Once the job is finished processing it will return order details. The order job typically finishes processing within 30 seconds. The order details include a similar schema as the quote response in addition to the `serviceOrderNumber` attribute.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "services",
                "order-management",
                "v2",
                "job",
                ":jobId"
